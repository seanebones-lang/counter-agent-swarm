# Operator configuration only; never put secrets in this tracked file.
COUNTER_SWARM_RUNTIME_CONFIG=/data/private/runtime.json
COUNTER_SWARM_CONTROL_BINDING=/data/private/control-binding.json
COUNTER_SWARM_MOTHERSHIP_AGENT_ID=agt_REPLACE_WITH_DEDICATED_CONTROLLER
MS_PRODUCT_BINDINGS_FILE=/data/private/mothership-bindings.json
MS_DEADBOLT_REQUIRED=true
MS_DATABASE_URL=sqlite:////data/private/mothership.sqlite3
MS_DATA_DIR=/data/private/mothership
MS_SMTP_ENABLED=false
MS_SCHEDULER_ENABLED=false
COUNTER_SWARM_MAX_MODEL_CALLS=0
# Set credentials through private runtime files / platform secret variables.
# OPENAI_API_KEY, DEADBOLT_TOKEN, MS_BOOTSTRAP_OWNER_KEY are intentionally absent.
